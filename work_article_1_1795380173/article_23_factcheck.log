  },
  {
    "fact_id": 26,
    "statement": "Maghiarii au un număr mai mare de reprezentanți în Parlament datorită numărului lor mai mare.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 27,
    "statement": "România recunoaște identitatea minorităților naționale și le asigură dreptul de a-și manifesta și afirma identitatea.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 28,
    "statement": "România sprijină cultivarea limbii, culturii și tradițiilor minorităților naționale.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 29,
    "statement": "România consideră limba, cultura și tradițiile minorităților naționale componente ale patrimoniului cultural comun și o îmbogățire a patrimoniului național.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 30,
    "statement": "România are o abordare de recunoaștere a minorităților naționale și a drepturilor lor specifice.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 31,
    "statement": "Români care trăiesc pe teritoriul altor state nu sunt recunoscuți în toate cazurile ca minorități naționale.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 32,
    "statement": "Există state europene care nu recunosc principiul minorităților naționale.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 33,
    "statement": "Unele state europene recunosc ca unic principiu cetățenia și nu acceptă ideea de naționalitate.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 34,
    "statement": "În unele state europene, naționalitatea este confundată cu statutul de cetățean.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 35,
    "statement": "Abordarea României privind minoritățile este conformă cu principiile proclamate de Consiliul Europei în materia minorităților naționale.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 36,
    "statement": "Ion Iliescu susține că abordarea României privind minoritățile depășește principiile proclamate de Consiliul Europei în această materie.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 37,
    "statement": "Drepturile recunoscute minorităților în România nu se întâlnesc în foarte multe state europene.",
    "speaker": "Ion Iliescu"
