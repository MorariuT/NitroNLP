  },
  {
    "fact_id": 11,
    "statement": "Lupta pentru emanciparea națională în Transilvania și-a găsit expresia după eliberarea Transilvaniei și unirea ei cu România, după primul război mondial.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 12,
    "statement": "Muntenia și Moldova s-au aflat aproximativ 500 de ani sub dominație turcă.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 13,
    "statement": "Muntenia și Moldova s-au aflat sub dominație turcă, nu sub ocupație turcă.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 14,
    "statement": "Turcii au recunoscut existența Munteniei și Moldovei ca state, precum și organizarea lor politică, limba și religia.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 15,
    "statement": "Muntenia și Moldova nu au devenit pașalâcuri turcești.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 16,
    "statement": "Muntenia și Moldova și-au obținut independența mai devreme decât alte teritorii menționate.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 17,
    "statement": "Muntenia și Moldova s-au organizat ca stat unificat după 1859.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 18,
    "statement": "Muntenia, Moldova și Transilvania s-au organizat pentru prima dată într-un stat național unitar după primul război mondial.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 19,
    "statement": "Statul național unitar format după primul război mondial a inclus și jumătate din teritoriul fostei provincii Moldova.",
