  {
    "fact_id": 24,
    "statement": "După Revoluție a fost constituit un Parlament provizoriu.",
    "speaker": "Ion Iliescu"
  },
  {
    "fact_id": 25,
    "statement": "După alegerile din 1990, toate minoritățile naționale au primit automat câte un reprezentant în noul Parlament.",
